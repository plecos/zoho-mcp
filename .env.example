# Required. From the Server-based Application you registered in the Zoho API
# Console. Nothing else in this file has to be filled in.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional. Both are looked up from the Zoho API on first use and cached for
# the life of the server process, so leaving them blank works. Filling them
# in (zoho-mcp-setup prints both) just saves those lookups. A blank value
# reads the same as an absent one.
ZOHO_ACCOUNT_ID=
ZOHO_CALENDAR_UID=

# Optional. If "true", get_email strips invisible Unicode padding characters
# (e.g. combining grapheme joiner) some marketing emails use to pad preview
# text. Off by default. Never touches zero-width joiner/non-joiner, since
# those carry real meaning in emoji sequences and some scripts.
ZOHO_STRIP_INVISIBLE_CHARS=false

# Optional, and off by default on purpose. When "false" (or unset), this
# server will only ever SAVE DRAFTS -- create_draft and reply_draft work
# normally, while send_email refuses before contacting Zoho, so no message
# can leave the account. Set to "true" to allow send_email to actually
# deliver mail -- matched case-insensitively, so "TRUE" and "True" enable it
# too. Any other value leaves sending off.
#
# Leave this off unless you specifically want an assistant able to email
# people on your behalf without review. Sending is irreversible, reaches a
# third party, and email bodies are untrusted input -- a message in the
# mailbox can contain text trying to talk the assistant into sending
# something. Drafts keep a human in the loop for exactly that reason.
ZOHO_ALLOW_AUTO_SEND=false

# Optional. Local port the one-time `zoho-mcp-setup` OAuth redirect listens on.
# Must match the redirect URI registered in the Zoho API Console
# (http://localhost:<port>/callback). Only used during setup, never at runtime.
ZOHO_OAUTH_CALLBACK_PORT=8765

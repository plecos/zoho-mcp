# Required. From the Server-based Application you registered in the Zoho API
# Console. Nothing else in this file has to be filled in.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional. Both are looked up from the Zoho API on first use and cached for
# the life of the server process, so leaving them blank works. Filling them
# in (zoho-mcp-setup prints both) just saves those lookups. A blank value
# reads the same as an absent one.
ZOHO_ACCOUNT_ID=
ZOHO_CALENDAR_UID=

# Optional. If "true", strips the invisible Unicode padding characters (e.g.
# combining grapheme joiner) some marketing emails use to inflate preview
# text -- from get_email bodies and from the snippet of every search_emails
# and list_emails result, where it's otherwise the bulk of what you get back
# for such messages. Subjects are left alone. Off by default. Never touches
# zero-width joiner/non-joiner, since those carry real meaning in emoji
# sequences and some scripts.
ZOHO_STRIP_INVISIBLE_CHARS=false

# Optional, and off by default on purpose. When "false" (or unset), this
# server will only ever SAVE DRAFTS -- create_draft and reply_draft work
# normally, and send_email composes to Drafts instead of delivering, so no
# message can leave the account. Set to "true" to allow send_email to actually
# deliver mail -- matched case-insensitively, so "TRUE" and "True" enable it
# too. Any other value leaves sending off.
#
# Leave this off unless you specifically want an assistant able to email
# people on your behalf without review. Sending is irreversible, reaches a
# third party, and email bodies are untrusted input -- a message in the
# mailbox can contain text trying to talk the assistant into sending
# something. Drafts keep a human in the loop for exactly that reason.
#
# Off, send_email doesn't error: it saves the message to Drafts for you to
# review and send yourself. An MCPB bundle install exposes this as a
# checkbox instead, so you don't need this file for it.
ZOHO_ALLOW_AUTO_SEND=false

# Optional, and off by default. When "true", the check_for_updates tool asks
# GitHub's public releases API whether a newer version of this server has been
# published -- the only request this server makes to a host other than Zoho.
# It sends nothing about your account and never downloads or installs
# anything; you're told where to get the new bundle. Off, the tool still
# reports which version you're running, without any network call. Matched
# case-insensitively; any value other than "true" leaves it off.
ZOHO_CHECK_FOR_UPDATES=false

# Optional. Local port the one-time `zoho-mcp-setup` OAuth redirect listens on.
# Must match the redirect URI registered in the Zoho API Console
# (http://localhost:<port>/callback). Only used during setup, never at runtime.
ZOHO_OAUTH_CALLBACK_PORT=8765

# --- Hosted (`zoho-mcp-http`) only ------------------------------------------
# None of the following are read by the normal stdio server. They exist for
# running this where a client can't spawn a local process -- a phone. See
# "Running it for a phone" in the README.

# Optional. Where the refresh token is read from. "keyring" (the default) is
# the OS credential store. "env" reads ZOHO_REFRESH_TOKEN below instead, for a
# host that has no credential store. Any other value refuses to start rather
# than falling back, since a silent fallback would present as "not
# authenticated" and send you looking at the wrong thing.
ZOHO_TOKEN_STORE=keyring

# Only read when ZOHO_TOKEN_STORE=env, and read-only -- nothing in the process
# can write it back, so `authenticate` refuses rather than opening a browser
# on a machine nobody is sitting at. Obtain the value by running
# `zoho-mcp-setup` on a machine with a browser, then
# `keyring get zoho-mcp zoho_refresh_token`. It doesn't expire on its own;
# treat it like a password in transit.
ZOHO_REFRESH_TOKEN=

# Required by `zoho-mcp-http` -- it refuses to start without one, and there is
# no default because a built-in secret is a published secret. Callers send it
# as `Authorization: Bearer <token>`; a request without it reaches no tool.
# Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ZOHO_HTTP_AUTH_TOKEN=

# Optional. Interface and port `zoho-mcp-http` binds. Loopback by default on
# purpose: reaching this from a phone means a tunnel or reverse proxy in
# front, and both connect over loopback. Binding 0.0.0.0 publishes the mailbox
# to the host's whole network the moment a firewall rule goes missing.
ZOHO_HTTP_HOST=127.0.0.1
ZOHO_HTTP_PORT=8000
